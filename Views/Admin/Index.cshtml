                        toastBody.innerText = "@Html.Raw(TempData["Error"])";

                        bootstrapToast.show();

                        // Auto-reopen the Create User modal so they can fix the password
                        var createModal = new bootstrap.Modal(document.getElementById('createUserModal'));
                        createModal.show();
                        </text>
                }
            });
        </script>
    } *@
</body>
</html>