@model CRM.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

<div class="container-fluid p-4">

    <div class="dashboard-header animate-in">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2>Dashboard</h2>
                <p>Welcome back! Here's what's happening with your sales pipeline and customer growth.</p>
            </div>
            <a asp-controller="Customers" asp-action="Create" class="btn btn-header">
                <i class="fa-solid fa-plus me-2"></i> New Customer
            </a>
        </div>
    </div>

    <div class="quick-stats-bar animate-in animate-delay-1">
        <div class="quick-stat">
            <div class="quick-stat-icon" style="background: #E0F2FE; color: #0284C7;">
                <i class="fa-solid fa-chart-line"></i>
            </div>
            <div class="quick-stat-content">
                <h6>Growth Rate</h6>
                <p>+@((Model.NewCustomersThisMonth * 100.0 / Math.Max(Model.TotalCustomers, 1)).ToString("F0"))%</p>
            </div>
        </div>

        <div class="quick-stat">
            <div class="quick-stat-icon" style="background: #DCFCE7; color: #16A34A;">
                <i class="fa-solid fa-calendar-check"></i>
            </div>
            <div class="quick-stat-content">
                <h6>This Month</h6>
                <p>@DateTime.Now.ToString("MMMM yyyy")</p>
            </div>
        </div>

        <div class="quick-stat">
            <div class="quick-stat-icon" style="background: #FEF3C7; color: #D97706;">
                <i class="fa-solid fa-fire"></i>
            </div>
            <div class="quick-stat-content">
                <h6>Active Deals</h6>
                <p>@Model.RecentActivities.Count()</p>
            </div>
        </div>

        <div class="performance-badge">
            <i class="fa-solid fa-arrow-trend-up"></i>
            <span>Performing Well</span>
        </div>
    </div>

    <div class="row mb-4 g-4">
        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card kpi-card animate-in animate-delay-1">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="d-flex align-items-start">
                        <div class="stat-icon-circle me-3" style="background: #E0F2FE; color: #0284C7;">
                            <i class="fa-solid fa-users"></i>
                        </div>
                        <div>
                            <div class="stat-label">Active Customers</div>
                            <div class="stat-value">@Model.TotalCustomers</div>
                            <div class="stat-change positive">
                                <i class="fa-solid fa-arrow-up"></i>
                                <span>Active</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card kpi-card animate-in animate-delay-2">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="d-flex align-items-start">
                        <div class="stat-icon-circle me-3" style="background: #DCFCE7; color: #16A34A;">
                            <i class="fa-solid fa-user-plus"></i>
                        </div>
                        <div>
                            <div class="stat-label">New This Month</div>
                            <div class="stat-value">@Model.NewCustomersThisMonth</div>
                            <div class="stat-change positive">
                                <i class="fa-solid fa-arrow-up"></i>
                                <span>+@((Model.NewCustomersThisMonth * 100.0 / Math.Max(Model.TotalCustomers, 1)).ToString("F0"))%</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card kpi-card animate-in animate-delay-3">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="d-flex align-items-start">
                        <div class="stat-icon-circle me-3" style="background: #FFF7ED; color: #EA580C;">
                            <i class="fa-regular fa-address-card"></i>
                        </div>
                        <div>
                            <div class="stat-label">Total Contacts</div>
                            <div class="stat-value">@Model.TotalContacts</div>
                            <div class="stat-change neutral">
                                <i class="fa-solid fa-minus"></i>
                                <span>@(Model.TotalCustomers > 0 ? (Model.TotalContacts * 1.0 / Model.TotalCustomers).ToString("F1") : "0") avg</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card kpi-card animate-in animate-delay-4">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="d-flex align-items-start">
                        <div class="stat-icon-circle me-3" style="background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%); color: white;">
                            <i class="fa-solid fa-sack-dollar"></i>
                        </div>
                        <div>
                            <div class="stat-label">Pipeline Value</div>
                            <div class="stat-value">$@Model.TotalPipelineValue.ToString("N0")</div>
                            <div class="stat-change positive">
                                <i class="fa-solid fa-arrow-up"></i>
                                <span>Total</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4 g-4">
        <div class="col-lg-8">
            <div class="dashboard-card animate-in animate-delay-2">
                <div class="card-header-clean">
                    <h5>Customer Acquisition Trend</h5>
                    <small class="text-muted ms-auto">Last 6 months</small>
                </div>
                <div class="card-body p-4">
                    <div class="chart-container">
                        <canvas id="growthChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="dashboard-card animate-in animate-delay-3">
                <div class="card-header-clean">
                    <h5>Market Distribution</h5>
                </div>
                <div class="card-body p-4 d-flex justify-content-center align-items-center" style="height: 360px;">
                    <canvas id="industryChart" style="max-height: 280px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-lg-8">
            <div class="dashboard-card animate-in animate-delay-3">
                <div class="card-header-clean d-flex justify-content-between align-items-center">
                    <h5>Recent Activity</h5>
                    <small class="text-muted">Last 30 days</small>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @if (Model.RecentActivities.Any())
                        {
                            @foreach (var note in Model.RecentActivities)
                            {
                                <div class="activity-feed-item">
                                    <div class="d-flex">
                                        <div class="activity-icon me-3">
                                            <i class="fa-solid fa-note-sticky"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div>
                                                    <h6 class="mb-0 fw-bold" style="color: var(--primary-blue); font-size: 1rem;">
                                                        @note.Customer.CompanyName
                                                    </h6>
                                                    <span class="activity-badge">Note</span>
                                                </div>
                                                <small class="text-muted" style="font-size: 0.75rem; white-space: nowrap;">
                                                    @note.CreatedAt.ToString("MMM dd, hh:mm tt")
                                                </small>
                                            </div>
                                            <p class="mb-0 text-dark" style="font-size: 0.9rem; line-height: 1.6;">
                                                @note.Content
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <div class="empty-state-icon">
                                    <i class="fa-regular fa-folder-open"></i>
                                </div>
                                <h6>No Recent Activity</h6>
                                <p>Start adding notes and interactions to see your activity feed here.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="dashboard-card animate-in animate-delay-4">
                <div class="card-header-clean">
                    <h5>Industry Breakdown</h5>
                </div>
                <div class="card-body p-0">
                    <div class="p-3">
                        @if (Model.CustomersByIndustry.Any())
                        {
                            @foreach (var industry in Model.CustomersByIndustry)
                            {
                                <div class="industry-item">
                                    <span class="industry-name">@industry.Key</span>
                                    <span class="industry-badge">
                                        @industry.Value
                                    </span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <div class="empty-state-icon">
                                    <i class="fa-solid fa-chart-pie"></i>
                                </div>
                                <h6>No Industry Data</h6>
                                <p>Add customers to see industry breakdown.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Retrieve data from Razor Model
            const growthKeys = @Html.Raw(Json.Serialize(Model.MonthlyGrowth.Keys));
            const growthValues = @Html.Raw(Json.Serialize(Model.MonthlyGrowth.Values));
            const industryKeys = @Html.Raw(Json.Serialize(Model.CustomersByIndustry.Keys));
            const industryValues = @Html.Raw(Json.Serialize(Model.CustomersByIndustry.Values));

            // Initialize the charts using the function from dashboard.js
            initDashboardCharts(growthKeys, growthValues, industryKeys, industryValues);
        });
    </script>
}