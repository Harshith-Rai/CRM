@model CRM.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="color: var(--deep-blue);">Dashboard</h2>
            <p class="text-muted">Welcome back! Here is what's happening today.</p>
        </div>
        <a asp-controller="Customers" asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Quick Add Customer
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle p-3 me-3" style="background: #E6F2FF; color: #0066CC;">
                        <i class="fa-solid fa-users fa-2x"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">Total Active Customers</h6>
                        <h2 class="fw-bold mb-0">@Model.TotalCustomers</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle p-3 me-3" style="background: #E6FFFA; color: #00B188;">
                        <i class="fa-solid fa-chart-line fa-2x"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">New This Month</h6>
                        <h2 class="fw-bold mb-0">@Model.NewCustomersThisMonth</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle p-3 me-3" style="background: #FFF7ED; color: #F59E0B;">
                        <i class="fa-regular fa-address-card fa-2x"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">Total Contacts</h6>
                        <h2 class="fw-bold mb-0">@Model.TotalContacts</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Recent Activity</h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @foreach (var note in Model.RecentActivities)
                        {
                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="mb-1 fw-bold text-primary">@note.Customer.CompanyName</h6>
                                        <p class="mb-1 text-dark">@note.Content</p>
                                        <small class="text-muted">
                                            <i class="fa-regular fa-user"></i> Note by You
                                        </small>
                                    </div>
                                    <small class="text-muted text-nowrap">
                                        @note.CreatedAt.ToString("MMM dd")
                                    </small>
                                </div>
                            </div>
                        }
                        @if (!Model.RecentActivities.Any())
                        {
                            <div class="p-5 text-center text-muted">
                                <i class="fa-solid fa-ghost fa-2x mb-3"></i>
                                <p>No recent activity. Go to a customer and add a note!</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Top Industries</h5>
                </div>
                <div class="card-body">
                    @foreach (var industry in Model.CustomersByIndustry)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span>@industry.Key</span>
                            <span class="badge bg-light text-dark border">@industry.Value</span>
                        </div>
                    }
                    @if (!Model.CustomersByIndustry.Any())
                    {
                        <p class="text-muted text-center">Add customers to see industry stats.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>