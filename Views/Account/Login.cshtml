@using CRM.DTOS;
@model LoginDto;

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MRI CRM - Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/css/login.css" rel="stylesheet" />
</head>
<body>
    <!-- Background decorations -->
    <div class="bg-decoration"></div>
    <div class="bg-decoration"></div>
    <div class="bg-decoration"></div>

    <div class="login-container">
        <!-- Left side - Brand section -->
        <div class="brand-section">
            <div class="brand-content">
                <div class="logo">mni</div>
                <div class="logo-subtitle">REAL ESTATE SOFTWARE</div>
                <div class="decorative-line"></div>
                <h1 class="brand-tagline">Welcome back to your command center</h1>
                <p class="brand-description">
                    Manage your real estate business with powerful tools designed for modern professionals.
                    Access your properties, clients, and insights all in one place.
                </p>
            </div>
        </div>

        <!-- Right side - Login form -->
        <div class="form-section">
            <div class="login-card">
                <div class="login-header">
                    <h2>Sign In</h2>
                    <p>Enter your credentials to access your account</p>
                </div>

                @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { id = "loginForm" }))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                    <div class="form-group">
                        @Html.LabelFor(m => m.Email, "Email Address")
                        <div class="input-wrapper">
                            @Html.TextBoxFor(m => m.Email, new {
                            @class = "form-control",
                                                placeholder = "you@example.com",
                                                type = "email",
                                                autocomplete = "username"
                                                })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Password, "Password")
                    <div class="input-wrapper">
                        @Html.PasswordFor(m => m.Password, new {
                                                @class = "form-control",
                                                placeholder = "Enter your password",
                                                autocomplete = "current-password"
                                                })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
                    </div>
                </div>

                <div class="remember-forgot">
                    <label class="remember-me">
                        @* @Html.CheckBoxFor(m => m.RememberMe, new { id = "remember" }) *@
                        <span>Remember me</span>
                    </label>
                    @Html.ActionLink("Forgot password?", "ForgotPassword", "Account", null, new { @class = "forgot-password" })
                </div>

                <button type="submit" class="btn-login">Sign In</button>
                                }

                <div class="divider">
                    <span>Or continue with</span>
                </div>

                <div class="signup-link">
                    Don't have an account? @Html.ActionLink("Sign up", "Register", "Account")
                </div>
            </div>
        </div>
    </div>

    <script src="~/Scripts/login.js"></script>
</body>
</html>
