@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CRM</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/forgotpassword.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        .back-link-container {
            text-align: center;
            margin-top: 20px;
        }

        .back-link {
            text-decoration: none;
            color: #666;
            font-weight: 500;
            font-size: 0.95rem;
            transition: color 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .back-link:hover {
                color: #000; /* Or your primary theme color */
                text-decoration: underline;
            }
    </style>
</head>
<body>
    <div class="bg-decoration"></div>
    <div class="bg-decoration"></div>
    <div class="bg-decoration"></div>

    <div class="login-container">
        <div class="brand-section">
            <div class="brand-content">
                <div class="logo">CRM</div>
                <div class="logo-subtitle">CUSTOMER RELATIONSHIP MANAGEMENT</div>
                <div class="decorative-line"></div>
                <h1 class="brand-tagline">Forgot Password</h1>
                <p class="brand-description">Enter your email to reset your password</p>
            </div>
        </div>

        <div class="form-section">
            <div class="login-card">
                <div class="login-header">
                    <h2>Forgot Password</h2>
                    <p>Enter your email to reset your password</p>
                </div>

                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label for="email">Email</label>
                        <div class="input-wrapper">
                            <i class="input-icon fas fa-envelope"></i>
                            <input id="email" name="email" type="email" placeholder="you@example.com" required />
                        </div>
                    </div>

                    <button type="submit" class="btn-login">Send Reset Link</button>

                    <div class="back-link-container">
                        <a href="@Url.Action("Login", "Account")" class="back-link">
                            <i class="fas fa-arrow-left"></i> Back to Login
                        </a>
                    </div>
                </form>

                @if (TempData["Message"] != null)
                {
                    <p style="margin-top: 20px; color: green; text-align: center;">@TempData["Message"]</p>
                }

                @if (TempData["ResetToken"] != null && Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development")
                {
                    <div style="margin-top: 20px; padding: 10px; background: #fff; border-radius: 10px;">
                        <strong>Dev Debug Token:</strong>
                        <p style="word-break: break-all;">@TempData["ResetToken"]</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="~/Scripts/login.js"></script>
</body>
</html>