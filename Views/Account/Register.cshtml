@using CRM.DTOS
@model RegisterDto

@{
    ViewData["Title"] = "Create Account";
    // If you are using a Layout, you might want to set Layout = null;
    // to see the full effect of the centering and background.
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        /* 1. Global Reset & Full Screen Centering */
        body {
            margin: 0;
            padding: 0;
            display: flex;
            align-items: center; /* Vertical Center */
            justify-content: center; /* Horizontal Center */
            min-height: 100vh;
            background: radial-gradient(circle at top left, #1a1a1a, #000000);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: #ffffff;
            overflow-x: hidden;
        }

        /* 2. The Glass Container with Shadow */
        .register-container {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 48px;
            border-radius: 28px;
            width: 100%;
            max-width: 400px;
            /* High-end Multi-layered Shadow */
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 20px 40px -10px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.05); /* Subtle rim light */

            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

            .register-container:hover {
                transform: translateY(-8px);
            }

        /* 3. Typography & Titles */
        h2 {
            font-size: 2.2rem;
            font-weight: 800;
            margin: 0 0 8px 0;
            text-align: center;
            letter-spacing: -1px;
            background: linear-gradient(to bottom, #fff, #888);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .subtitle {
            text-align: center;
            color: #777;
            font-size: 0.95rem;
            margin-bottom: 32px;
        }

        /* 4. Form Styling */
        .form-group {
            margin-bottom: 24px;
        }

        label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            margin-bottom: 8px;
            color: #aaa;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        input {
            width: 100%;
            padding: 14px 18px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            color: #fff;
            font-size: 1rem;
            transition: all 0.3s ease;
            box-sizing: border-box;
        }

            input:focus {
                outline: none;
                background: rgba(255, 255, 255, 0.1);
                border-color: rgba(255, 255, 255, 0.5);
                box-shadow: 0 0 20px rgba(255, 255, 255, 0.05);
            }

        /* Input Placeholder color */
        ::placeholder {
            color: #444;
        }

        /* 5. The White "Pop" Button */
        .btn-register {
            width: 100%;
            padding: 16px;
            background: #ffffff;
            color: #000;
            border: none;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 12px;
            box-shadow: 0 10px 20px rgba(255, 255, 255, 0.1);
        }

            .btn-register:hover {
                background: #f0f0f0;
                transform: scale(1.02);
                box-shadow: 0 15px 25px rgba(255, 255, 255, 0.15);
            }

        /* 6. Footer & Validation */
        .footer-text {
            text-align: center;
            margin-top: 32px;
            font-size: 0.9rem;
            color: #666;
        }

            .footer-text a {
                color: #fff;
                text-decoration: none;
                font-weight: 600;
                border-bottom: 1px solid transparent;
                transition: border 0.3s ease;
            }

                .footer-text a:hover {
                    border-bottom: 1px solid #fff;
                }

        .validation-msg {
            font-size: 0.8rem;
            margin-top: 6px;
            display: block;
            color: #ff453a;
        }

        .error-summary {
            background: rgba(255, 69, 58, 0.1);
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 24px;
            color: #ff453a;
            font-size: 0.85rem;
            border: 1px solid rgba(255, 69, 58, 0.2);
        }

        ul {
            margin: 0;
            padding-left: 20px;
        }
    </style>
</head>
<body>

    <div class="register-container">
        <h2>Join Us</h2>
        <p class="subtitle">Create your account to start reviewing.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="error-summary">
                @Html.ValidationSummary(false, "")
            </div>
        }

        <form asp-action="Register" method="post">
            <div class="form-group">
                <label asp-for="FullName">Full Name</label>
                <input asp-for="FullName" placeholder="e.g. John Doe" autocomplete="off" />
                <span asp-validation-for="FullName" class="validation-msg"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email Address</label>
                <input asp-for="Email" placeholder="name@example.com" />
                <span asp-validation-for="Email" class="validation-msg"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" placeholder="••••••••" />
                <span asp-validation-for="Password" class="validation-msg"></span>
            </div>

            <button type="submit" class="btn-register">Create Account</button>
        </form>

        <div class="footer-text">
            Already have an account?
            <a asp-action="Login">Sign in</a>
        </div>
    </div>

</body>
</html>