@model CRM.Models.SalesRepDashboardViewModel

@{
    ViewData["Title"] = "Home Page";
    // Layout = "~/Views/Shared/_Layout_App.cshtml";
	// Layout = null;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    /* --- MRI Theme Variables --- */
    :root {
        --mri-blue: #044D66;
        --medium-blue: #187ABF;
        --bright-blue: #179AD7;
        --light-blue: #C2E6F2;
        --light-green: #00B188;
        --orange: #FAA41C;
        --red-orange: #F36C3C;
        --white: #ffffff;
        --text-dark: #1e293b;
        --text-light: #64748b;
    }

    body {
        font-family: 'DM Sans', sans-serif;
        background-color: #F8FAFC; /* Light gray background */
        color: var(--text-dark);
    }

    h1, h2, h3, h4 {
        font-family: 'Outfit', sans-serif;
    }

    /* --- Background Decorations (Matches Login) --- */
    .bg-decoration {
        position: fixed;
        border-radius: 50%;
        filter: blur(80px);
        z-index: -1;
        opacity: 0.6;
    }

    .blob-1 {
        top: -10%;
        right: -5%;
        width: 400px;
        height: 400px;
        background: rgba(194, 230, 242, 0.4);
    }
    /* Light Blue */
    .blob-2 {
        bottom: -10%;
        left: -5%;
        width: 300px;
        height: 300px;
        background: rgba(24, 122, 191, 0.1);
    }
    /* Medium Blue */

    /* --- Layout Grid --- */
    .dashboard-container {
        padding: 0 10px;
        display: grid;
        grid-template-columns: 2.5fr 1fr;
        gap: 24px;
    }

    /* --- Cards (Based on Login Card) --- */
    .mri-card {
        background: var(--white);
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); /* Soft subtle shadow */
        border: 1px solid rgba(255,255,255,0.5);
        margin-bottom: 24px;
        transition: transform 0.2s ease;
    }

        .mri-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .card-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--mri-blue);
        margin: 0;
    }

    /* --- Hero / Target Section --- */
    .hero-card {
        background: linear-gradient(135deg, var(--mri-blue), var(--medium-blue));
        color: var(--white);
        position: relative;
        overflow: hidden;
    }

        /* Decorative line from login brand section */
        .hero-card::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 150px;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.05));
            transform: skewX(-20deg);
        }

    .hero-stat {
        font-size: 3.5rem;
        font-weight: 700;
        line-height: 1;
        margin-bottom: 10px;
        font-family: 'Outfit', sans-serif;
    }

    .progress-track {
        background: rgba(255,255,255,0.15);
        height: 8px;
        border-radius: 4px;
        margin-top: 20px;
        overflow: hidden;
    }

    .progress-fill {
        background: var(--light-green);
        height: 100%;
        border-radius: 4px;
        transition: width 1s ease;
    }

    /* --- Task List Styles --- */
    .task-item {
        display: flex;
        align-items: center;
        padding: 16px 0;
        border-bottom: 1px solid #F1F5F9;
    }

        .task-item:last-child {
            border-bottom: none;
        }

    .task-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 16px;
        font-size: 1.2rem;
    }

    .icon-call {
        background: #E0F2FE;
        color: var(--medium-blue);
    }

    .icon-email {
        background: #FFEDD5;
        color: var(--orange);
    }

    .icon-meeting {
        background: #DCFCE7;
        color: var(--light-green);
    }

    .task-details h4 {
        margin: 0 0 4px 0;
        font-size: 1rem;
        color: var(--text-dark);
    }

    .task-details p {
        margin: 0;
        font-size: 0.85rem;
        color: var(--text-light);
    }

    .btn-action {
        margin-left: auto;
        padding: 8px 16px;
        background: var(--light-green);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
        transition: opacity 0.2s;
    }

        .btn-action:hover {
            opacity: 0.9;
        }

    /* --- Sidebar Widgets --- */
    .lead-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px dashed #E2E8F0;
    }

        .lead-row:last-child {
            border-bottom: none;
        }

    .score-badge {
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .hot {
        background: #FEF2F2;
        color: var(--red-orange);
    }

    .warm {
        background: #FFF7ED;
        color: var(--orange);
    }

    .pipeline-stat {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        color: var(--text-light);
    }

    .stat-value {
        font-weight: 700;
        color: var(--mri-blue);
    }
</style>

<div class="bg-decoration blob-1"></div>
<div class="bg-decoration blob-2"></div>

<div style="margin-bottom: 30px;">
    <h1 style="color: var(--mri-blue); font-weight: 700; margin-bottom: 5px;">Welcome Back</h1>
    <p style="color: var(--text-light); margin: 0;">Here is your daily briefing and performance overview.</p>
</div>

<div class="dashboard-container">

    <div class="main-content">

        <div class="mri-card hero-card">
            <div style="position: relative; z-index: 2;">
                <div class="card-header">
                    <span style="opacity: 0.9; font-weight: 500;">Current Performance</span>
                    <span style="background: rgba(255,255,255,0.2); padding: 5px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">
                        @Model.TargetProgressPercentage% of Goal
                    </span>
                </div>

                <div class="hero-stat">$@Model.TotalSalesThisMonth.ToString("N0")</div>
                <div style="opacity: 0.8; font-size: 0.95rem;">Revenue Closed This Month</div>

                <div class="progress-track">
                    <div class="progress-fill" style="width: @Model.TargetProgressPercentage%"></div>
                </div>
                <div style="text-align: right; margin-top: 8px; font-size: 0.8rem; opacity: 0.8;">
                    Target: $@Model.MonthlyTarget.ToString("N0")
                </div>
            </div>
        </div>

        <div class="mri-card">
            <div class="card-header">
                <h3 class="card-title">Priority Tasks</h3>
                <a href="#" style="color: var(--bright-blue); text-decoration: none; font-weight: 600; font-size: 0.9rem;">View All</a>
            </div>

            @foreach (var task in Model.TodaysTasks)
            {
                <div class="task-item">
                    <div class="task-icon @(task.Type == "Call" ? "icon-call" : task.Type == "Email" ? "icon-email" : "icon-meeting")">
                        <i class="fa-solid @(task.Type == "Call" ? "fa-phone" : task.Type == "Email" ? "fa-envelope" : "fa-users")"></i>
                    </div>
                    <div class="task-details">
                        <h4>@task.Title</h4>
                        <p>@task.Subtitle</p>
                    </div>
                    <button class="btn-action">Done</button>
                </div>
            }

            @if (!Model.TodaysTasks.Any())
            {
                <p style="text-align: center; color: var(--text-light); padding: 20px;">No pending tasks for today.</p>
            }
        </div>
    </div>

    <div class="side-content">

        <div class="mri-card">
            <div class="card-header">
                <h3 class="card-title">🔥 Hot Leads</h3>
            </div>
            @foreach (var lead in Model.HotLeads)
            {
                <div class="lead-row">
                    <div>
                        <div style="font-weight: 600; color: var(--mri-blue);">@lead.Name</div>
                        <div style="font-size: 0.8rem; color: var(--text-light);">@lead.Company</div>
                    </div>
                    <div class="score-badge hot">@lead.Score% Match</div>
                </div>
            }
        </div>

        <div class="mri-card">
            <div class="card-header">
                <h3 class="card-title">Pipeline</h3>
            </div>

            <div class="pipeline-stat">
                <span>Proposal Sent</span>
                <span class="stat-value">@Model.DealsInProposal</span>
            </div>
            <div class="pipeline-stat">
                <span>Negotiation</span>
                <span class="stat-value">@Model.DealsInNegotiation</span>
            </div>
            <div style="border-top: 1px solid #F1F5F9; margin: 10px 0;"></div>
            <div class="pipeline-stat">
                <span style="color: var(--light-green); font-weight: 600;">Closed Won</span>
                <span class="stat-value" style="color: var(--light-green);">@Model.DealsClosedWon</span>
            </div>
        </div>

    </div>
</div>