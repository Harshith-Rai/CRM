@model CRM.Models.SalesRepDashboardViewModel

@{
    ViewData["Title"] = "Sales Dashboard";
}

<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

<style>
    /* --- Sales Rep Specific Overrides --- */
    .hero-goal-card {
        background: linear-gradient(135deg, #0F172A 0%, #334155 100%);
        color: white;
        border-radius: 16px;
        padding: 32px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 25px -5px rgba(15, 23, 42, 0.1), 0 10px 10px -5px rgba(15, 23, 42, 0.04);
        margin-bottom: 24px;
    }

        /* Abstract decoration for the hero card */
        .hero-goal-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            border-radius: 50%;
        }

    .goal-stat-label {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
        opacity: 0.7;
        margin-bottom: 8px;
    }

    .goal-stat-value {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 3.5rem;
        font-weight: 700;
        line-height: 1;
        margin-bottom: 4px;
    }

    .progress-container {
        background: rgba(255, 255, 255, 0.1);
        height: 10px;
        border-radius: 5px;
        margin: 24px 0;
        position: relative;
    }

    .progress-bar-fill {
        background: #38BDF8; /* Sky Blue */
        height: 100%;
        border-radius: 5px;
        box-shadow: 0 0 15px rgba(56, 189, 248, 0.6);
        transition: width 1.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Task Table Polish */
    .task-icon-box {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .task-call {
        background: #E0F2FE;
        color: #0284C7;
    }

    .task-email {
        background: #FFEDD5;
        color: #EA580C;
    }

    .task-meeting {
        background: #DCFCE7;
        color: #16A34A;
    }
</style>

<div class="container-fluid p-4">

    <div class="d-flex justify-content-between align-items-end mb-4 animate-in">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--text-main); font-family: 'Plus Jakarta Sans', sans-serif;">
                Overview
            </h2>
            <p class="text-muted mb-0">Track your performance and daily priorities.</p>
        </div>
        <div>
            <span class="badge bg-white text-secondary border px-3 py-2 rounded-pill shadow-sm">
                <i class="fa-regular fa-calendar me-2"></i> @DateTime.Now.ToString("MMMM dd, yyyy")
            </span>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="hero-goal-card animate-in animate-delay-1">
                <div class="d-flex justify-content-between align-items-start position-relative">
                    <div>
                        <div class="goal-stat-label">Revenue Closed This Month</div>
                        <div class="d-flex align-items-baseline gap-2">
                            <div class="goal-stat-value">$@Model.TotalSalesThisMonth.ToString("N0")</div>
                            <span class="text-white-50 fs-5">/ $@Model.MonthlyTarget.ToString("N0")</span>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="badge bg-white text-dark px-3 py-2 rounded-pill fw-bold shadow-sm">
                            <i class="fa-solid fa-bullseye me-2 text-primary"></i>
                            @Model.TargetProgressPercentage% Achieved
                        </div>
                    </div>
                </div>

                <div class="progress-container">
                    <div class="progress-bar-fill" style="width: @Math.Min(Model.TargetProgressPercentage, 100)%"></div>
                </div>

                <div class="d-flex justify-content-between text-white-50 small fw-medium">
                    <span><i class="fa-solid fa-play me-2"></i>Start of Month</span>
                    <span>Target Goal<i class="fa-solid fa-flag-checkered ms-2"></i></span>
                </div>
            </div>

            <div class="dashboard-card animate-in animate-delay-2">
                <div class="card-header-clean d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Priority Tasks</h5>
                    <a asp-controller="Tasks" asp-action="Index" class="btn btn-sm btn-light text-muted fw-bold">View All</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4 border-0 text-muted small text-uppercase fw-bold">Task Details</th>
                                    <th class="border-0 text-muted small text-uppercase fw-bold">Type</th>
                                    <th class="text-end pe-4 border-0 text-muted small text-uppercase fw-bold">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.TodaysTasks.Any())
                                {
                                    @foreach (var task in Model.TodaysTasks)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <div class="task-icon-box me-3 @(task.Type == "Call" ? "task-call" : task.Type == "Email" ? "task-email" : "task-meeting")">
                                                        <i class="fa-solid @(task.Type == "Call" ? "fa-phone" : task.Type == "Email" ? "fa-envelope" : "fa-users")"></i>
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold text-dark">@task.Title</div>
                                                        <div class="small text-muted">@task.Subtitle</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border">@task.Type</span>
                                            </td>
                                            <td class="text-end pe-4">
                                                <button onclick="markTaskDone(this, @task.Id)"
                                                        class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold transition-btn">
                                                    <i class="fa-solid fa-check me-1"></i> Done
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-5">
                                            <div class="text-muted opacity-50 mb-2">
                                                <i class="fa-solid fa-clipboard-check fa-2x"></i>
                                            </div>
                                            <p class="text-muted fw-medium mb-0">No pending tasks for today!</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-lg-4">
            <div class="dashboard-card h-100 animate-in animate-delay-3">
                <div class="card-header-clean">
                    <h5 class="mb-0">Recent Activity</h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @if (Model.RecentActivities.Any())
                        {
                            @foreach (var activity in Model.RecentActivities)
                            {
                                <div class="activity-feed-item">
                                    <div class="d-flex">
                                        <div class="activity-icon me-3">
                                            <i class="fa-solid @(activity.Type == "Call" ? "fa-phone" : activity.Type == "Status" ? "fa-arrows-rotate" : "fa-user-plus")"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between mb-1">
                                                <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.95rem;">@activity.CustomerName</h6>
                                                <small class="text-muted" style="font-size: 0.75rem;">@activity.TimeAgo</small>
                                            </div>
                                            <p class="mb-0 text-muted small">@activity.Action</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">
                                <small>No recent activity recorded.</small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function markTaskDone(button, taskId) {
            // 1. Visual Feedback (Immediate)
            var row = button.closest('tr');
            button.disabled = true;
            button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

            // 2. Send Request
            fetch('/Tasks/MarkDoneAjax?id=' + taskId, {
                method: 'POST',
                headers: {
                    // This creates a header for CSRF protection if your app requires it
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // 3. Success: Fade out and remove the row
                    row.style.transition = "all 0.5s";
                    row.style.opacity = "0";
                    row.style.transform = "translateX(20px)";
                    setTimeout(() => row.remove(), 500);
                } else {
                    // Revert if error
                    alert("Error updating task.");
                    button.disabled = false;
                    button.innerHTML = '<i class="fa-solid fa-check me-1"></i> Done';
                }
            })
            .catch(error => {
                console.error('Error:', error);
                button.disabled = false;
            });
        }
    </script>
}