@model CRM.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
}

<style>
    /* Import fonts */
    @@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap');

    :root {
        --primary-blue: #0066CC;
        --deep-blue: #003D82;
        --light-blue: #E6F2FF;
        --accent-teal: #00B4D8;
        --text-dark: #1A1A1A;
        --text-light: #6B7280;
        --border-color: #E2E8F0;
        --success-green: #10B981;
        --orange: #F59E0B;
        --danger-red: #DC2626;
        --light-red: #FEE2E2;
        --white: #FFFFFF;
    }

    body {
        background: linear-gradient(135deg, #f8fafc 0%, #e6f2ff 100%);
        font-family: 'DM Sans', sans-serif;
    }

    /* Page Container */
    .customer-details-wrapper {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 15px;
        animation: fadeIn 0.6s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Header Section */
    .customer-header {
        background: linear-gradient(135deg, var(--primary-blue) 0%, var(--deep-blue) 100%);
        color: var(--white);
        padding: 30px 40px;
        border-radius: 15px;
        box-shadow: 0 10px 40px rgba(0, 102, 204, 0.15);
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
    }

    .customer-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        z-index: 2;
    }

    /* Grid Layout */
    .grid-layout {
        display: grid;
        grid-template-columns: 28% 70%;
        gap: 24px;
        align-items: start;
    }

    /* Sidebar Wrapper (Left Column) */
    .sidebar-column {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    /* Cards */
    .contacts-section, .timeline-section, .add-note-card {
        background: var(--white);
        padding: 24px;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    }

    /* Add Note Card Specifics */
    .add-note-card {
        background: linear-gradient(135deg, #F8FAFC 0%, #FFFFFF 100%);
        border: 2px solid var(--border-color);
    }

    /* Section Headers */
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

        .section-header h4 {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--deep-blue);
            margin: 0;
            font-family: 'Outfit', sans-serif;
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .contact-card {
        background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
        padding: 15px;
        border-radius: 12px;
        border: 1px solid var(--border-color);
        margin-bottom: 12px;
        transition: all 0.3s ease;
    }

        .contact-card:hover {
            border-color: var(--primary-blue);
            transform: translateX(4px);
        }

    /* Note styling */
    .note-box {
        background: white;
        padding: 20px;
        border-radius: 12px;
        width: 100%;
        border: 1px solid var(--border-color);
    }

    /* Buttons & Badges */
    .customer-title-section h1 {
        margin: 0 0 12px 0;
        font-size: 2rem;
        font-weight: 700;
        font-family: 'Outfit', sans-serif;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .badge {
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .badge-success {
        background: var(--success-green);
        color: white;
    }

    .btn {
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-white {
        background: var(--white);
        color: var(--primary-blue);
    }

        .btn-white:hover {
            background: #f1f5f9;
            transform: translateY(-2px);
        }

    .btn-light-outline {
        background: transparent;
        color: var(--white);
        border: 2px solid rgba(255, 255, 255, 0.3);
    }

        .btn-light-outline:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--white);
        }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        font-size: 0.9rem;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary-blue) 0%, var(--deep-blue) 100%);
        color: white;
    }

    /* Timeline */
    .timeline-item {
        display: flex;
        gap: 20px;
        padding-bottom: 32px;
        border-left: 3px solid var(--border-color);
        padding-left: 32px;
        position: relative;
    }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -11px;
            top: 0;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: var(--primary-blue);
            border: 4px solid white;
            box-shadow: 0 0 0 2px var(--primary-blue);
        }

    .reminder-badge {
        margin-top: 10px;
        font-size: 0.8rem;
        color: var(--orange);
        background: #FFF7ED;
        padding: 4px 8px;
        border-radius: 6px;
        font-weight: 600;
        border: 1px solid #fed7aa;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    /* Contact Action Buttons */
    .contact-actions {
        display: flex;
        gap: 8px;
        margin-top: 12px;
    }

    .btn-sm {
        padding: 6px 12px;
        font-size: 0.8rem;
        border-radius: 8px;
        border: 1px solid transparent;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-sm-primary {
        background: var(--light-blue);
        color: var(--primary-blue);
        border-color: #bfdbfe;
    }

        .btn-sm-primary:hover {
            background: var(--primary-blue);
            color: white;
        }

    .btn-sm-danger {
        background: var(--light-red);
        color: var(--danger-red);
        border-color: #fecaca;
    }

        .btn-sm-danger:hover {
            background: var(--danger-red);
            color: white;
        }
</style>

<div class="customer-details-wrapper">
    <div class="customer-header">
        <div class="customer-header-content">
            <div class="customer-title-section">
                <h1>
                    @Model.CompanyName
                    <span class="badge badge-success">Active</span>
                </h1>
                <div class="customer-meta">
                    <span><i class="fa-solid fa-industry me-2"></i>@Model.Industry</span>
                    <span><i class="fa-solid fa-location-dot me-2"></i>@Model.Address</span>
                </div>
            </div>

            <div class="customer-actions" style="display:flex; gap: 10px;">
                <a href="mailto:@Model.Email" class="btn btn-white">
                    <i class="fa-regular fa-envelope"></i> Email
                </a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-light-outline">
                    <i class="fa-solid fa-pen-to-square"></i> Edit
                </a>
            </div>
        </div>
    </div>

    <div class="grid-layout">
        <div class="sidebar-column">
            <div class="contacts-section">
                <div class="section-header">
                    <h4><i class="fa-solid fa-users me-2"></i>People</h4>

                    <button type="button" class="btn btn-primary"
                            style="padding: 5px 10px; font-size: 0.8rem;"
                            data-bs-toggle="modal"
                            data-bs-target="#addContactModal">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                </div>

                @if (Model.Contacts != null && Model.Contacts.Any())
                {
                    foreach (var contact in Model.Contacts)
                    {
                        <div class="contact-card">
                            <div class="contact-name">@contact.FullName</div>
                            <div class="contact-pos">@contact.Position</div>

                            <div class="contact-actions">
                                <a href="mailto:@contact.Email" class="btn-sm btn-sm-primary" title="Email"><i class="fa-solid fa-envelope"></i></a>
                                <a href="tel:@contact.Phone" class="btn-sm btn-sm-primary" title="Call"><i class="fa-solid fa-phone"></i></a>
                                <a asp-controller="Contacts" asp-action="Delete" asp-route-id="@contact.Id"
                                   class="btn-sm btn-sm-danger" title="Delete Contact"
                                   onclick="return confirm('Delete @contact.FullName?');">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted small italic">No contacts added.</div>
                }
            </div>

            <div class="add-note-card">
                <div class="section-header mb-3">
                    <h4 style="font-size: 1.1rem;"><i class="fa-solid fa-pen-to-square me-2"></i>Log Interaction</h4>
                </div>
                <form asp-action="AddNote" method="post">
                    <input type="hidden" name="customerId" value="@Model.Id" />
                    <div class="mb-2">
                        <input name="title" class="form-control" placeholder="Subject (e.g. Call Summary)" required style="font-weight:600;" />
                    </div>
                    <div class="mb-2">
                        <textarea name="content" class="form-control" rows="4" placeholder="What happened?" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="text-label">Reminder:</label>
                        <input type="date" name="reminderDate" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-full">
                        <i class="fa-solid fa-floppy-disk me-2"></i> Save Note
                    </button>
                </form>
            </div>
        </div>

        <div class="timeline-section">
            <div class="section-header">
                <h4><i class="fa-solid fa-clock-rotate-left me-2"></i>Interaction Timeline</h4>
            </div>
            <div class="timeline-wrapper">
                @if (Model.Notes != null && Model.Notes.Any())
                {
                    @foreach (var note in Model.Notes.OrderByDescending(n => n.CreatedAt))
                    {
                        <div class="timeline-item">
                            <div class="note-box">
                                <div class="note-header">
                                    <div>
                                        <div class="note-title">@note.Title</div>
                                        <div class="note-date">@note.CreatedAt.ToString("MMM dd, yyyy • hh:mm tt")</div>
                                    </div>
                                    <div class="note-actions">
                                        <a asp-controller="Notes" asp-action="Edit" asp-route-id="@note.Id" class="btn-sm btn-icon-edit"><i class="fa-solid fa-pen"></i></a>
                                        <a asp-controller="Notes" asp-action="Delete" asp-route-id="@note.Id" class="btn-sm btn-icon-delete" onclick="return confirm('Delete note?');"><i class="fa-solid fa-trash"></i></a>
                                    </div>
                                </div>
                                <p class="note-content">@note.Content</p>
                                @if (note.ReminderDate.HasValue)
                                {
                                    <div class="reminder-badge"><i class="fa-regular fa-bell"></i> Follow up: @note.ReminderDate.Value.ToString("MMM dd")</div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fa-regular fa-comments fa-2x mb-2"></i>
                        <p>No interactions recorded yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addContactModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold" style="color: var(--deep-blue);">Add New Person</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-controller="Contacts" asp-action="Create" method="post">
                    <input type="hidden" name="CustomerId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">FULL NAME</label>
                        <input type="text" name="FullName" class="form-control" placeholder="e.g. John Doe" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">POSITION / TITLE</label>
                        <input type="text" name="Position" class="form-control" placeholder="e.g. Sales Manager" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small fw-bold">EMAIL</label>
                            <input type="email" name="Email" class="form-control" placeholder="john@company.com" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small fw-bold">PHONE</label>
                            <input type="tel" name="Phone" class="form-control" placeholder="+1 555..." />
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary fw-bold py-2">
                            <i class="fa-solid fa-user-plus me-2"></i> Save Contact
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}