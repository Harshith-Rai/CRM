@model CRM.Models.Customer

@{
    ViewData["Title"] = "Add New Customer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/Customers/create.css" />

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="bg-decoration blob-1"></div>
<div class="bg-decoration blob-2"></div>

<div class="mri-card">
    <div class="card-header-custom">
        <h4><i class="fa-solid fa-building"></i> Add New Company</h4>
    </div>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="CompanyName">Company Name</label>
            <input asp-for="CompanyName" class="form-control" placeholder="e.g. Acme Corp" />
            <span asp-validation-for="CompanyName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Industry">Industry</label>
            <select asp-for="Industry" class="form-select">
                <option value="">-- Select Industry --</option>
                <option value="Technology">Technology</option>
                <option value="Finance">Finance</option>
                <option value="Manufacturing">Manufacturing</option>
                <option value="Healthcare">Healthcare</option>
                <option value="Retail">Retail</option>
                <option value="Other">Other</option>
            </select>
            <span asp-validation-for="Industry" class="text-danger"></span>
        </div>

        <div class="row mb-3">
            <div class="col-md-6 mb-3 mb-md-0">
                <label asp-for="Email">Company Email</label>
                <input asp-for="Email" class="form-control" placeholder="info@company.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Phone">Phone</label>
                <input asp-for="Phone" class="form-control" placeholder="+1 555-0123" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Address">Address</label>
            <textarea asp-for="Address" class="form-control" rows="2" placeholder="123 Business Rd"></textarea>
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="form-footer">
            <a asp-action="Index" class="btn btn-cancel">Cancel</a>
            <button type="submit" class="btn btn-main">
                <i class="fa-solid fa-save me-2"></i> Save Customer
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
