@model CRM.Models.Customer

@{
    ViewData["Title"] = "Add New Customer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    :root {
        --mri-blue: #044D66;
        --medium-blue: #187ABF;
        --bright-blue: #179AD7;
        --light-blue: #C2E6F2;
        --light-green: #00B188;
        --orange: #FAA41C;
        --red-orange: #F36C3C;
        --white: #ffffff;
        --text-dark: #1e293b;
        --text-light: #64748b;
    }

    body {
        font-family: 'DM Sans', sans-serif;
        background-color: #F8FAFC;
        color: var(--text-dark);
    }

    h1, h2, h3, h4 {
        font-family: 'Outfit', sans-serif;
    }

    /* Decorative blobs */
    .bg-decoration {
        position: fixed;
        border-radius: 50%;
        filter: blur(80px);
        z-index: -1;
        opacity: 0.6;
    }

    .blob-1 {
        top: -10%;
        right: -5%;
        width: 400px;
        height: 400px;
        background: rgba(194, 230, 242, 0.4);
    }

    .blob-2 {
        bottom: -10%;
        left: -5%;
        width: 300px;
        height: 300px;
        background: rgba(24, 122, 191, 0.1);
    }

    /* Card container */
    .mri-card {
        background: var(--white);
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        padding: 40px;
        max-width: 720px;
        margin: 60px auto;
        border: 1px solid rgba(255,255,255,0.5);
    }

        .mri-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
        }

    .card-header-custom {
        margin-bottom: 30px;
        border-bottom: 1px solid #E2E8F0;
        padding-bottom: 10px;
    }

        .card-header-custom h4 {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            color: var(--mri-blue);
            display: flex;
            align-items: center;
            gap: 10px;
        }

    label {
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 5px;
    }

    input.form-control,
    select.form-select,
    textarea.form-control {
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 0.95rem;
        transition: border-color 0.2s ease;
    }

    input:focus,
    select:focus,
    textarea:focus {
        border-color: var(--medium-blue);
        box-shadow: 0 0 0 3px rgba(24, 122, 191, 0.1);
        outline: none;
    }

    .btn-main {
        background-color: var(--mri-blue);
        color: white;
        font-weight: 600;
        border-radius: 10px;
        padding: 10px 24px;
        transition: background 0.2s ease;
    }

        .btn-main:hover {
            background-color: var(--bright-blue);
        }

    .btn-cancel {
        border: 1px solid #E2E8F0;
        background: white;
        color: var(--text-dark);
        border-radius: 10px;
        padding: 10px 24px;
    }

        .btn-cancel:hover {
            background: #F1F5F9;
        }

    .form-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 30px;
    }

    .text-danger {
        font-size: 0.85rem;
    }
</style>

<div class="bg-decoration blob-1"></div>
<div class="bg-decoration blob-2"></div>

<div class="mri-card">
    <div class="card-header-custom">
        <h4><i class="fa-solid fa-building"></i> Add New Company</h4>
    </div>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="CompanyName">Company Name</label>
            <input asp-for="CompanyName" class="form-control" placeholder="e.g. Acme Corp" />
            <span asp-validation-for="CompanyName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Industry">Industry</label>
            <select asp-for="Industry" class="form-select">
                <option value="">-- Select Industry --</option>
                <option value="Technology">Technology</option>
                <option value="Finance">Finance</option>
                <option value="Manufacturing">Manufacturing</option>
                <option value="Healthcare">Healthcare</option>
                <option value="Retail">Retail</option>
                <option value="Other">Other</option>
            </select>
            <span asp-validation-for="Industry" class="text-danger"></span>
        </div>

        <div class="row mb-3">
            <div class="col-md-6 mb-3 mb-md-0">
                <label asp-for="Email">Company Email</label>
                <input asp-for="Email" class="form-control" placeholder="info@company.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Phone">Phone</label>
                <input asp-for="Phone" class="form-control" placeholder="+1 555-0123" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Address">Address</label>
            <textarea asp-for="Address" class="form-control" rows="2" placeholder="123 Business Rd"></textarea>
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="form-footer">
            <a asp-action="Index" class="btn btn-cancel">Cancel</a>
            <button type="submit" class="btn btn-main">
                <i class="fa-solid fa-save me-2"></i> Save Customer
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
