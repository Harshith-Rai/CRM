@model IEnumerable<CRM.Models.Customer>

@{
    ViewData["Title"] = "Archived Customers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-secondary"><i class="fa-solid fa-trash-can-arrow-up me-2"></i>Archived Customers</h2>
            <p class="text-muted">Restore customers you previously removed.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left"></i> Back to Active List
        </a>
    </div>

    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Company</th>
                    <th>Industry</th>
                    <th>Email</th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold text-muted">@item.CompanyName</td>
                        <td>@item.Industry</td>
                        <td>@item.Email</td>
                        <td class="text-end pe-4">
                            <a asp-action="Restore" asp-route-id="@item.Id" class="btn btn-sm btn-success text-white"
                               onclick="return confirm('Restore this customer to your active list?');">
                                <i class="fa-solid fa-rotate-left"></i> Restore
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            <i class="fa-regular fa-folder-open fa-2x mb-3"></i>
                            <p>The recycle bin is empty.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>