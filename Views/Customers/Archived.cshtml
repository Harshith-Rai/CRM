@model IEnumerable<CRM.Models.Customer>

@{
    ViewData["Title"] = "Recycle Bin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-secondary"><i class="fa-solid fa-trash-can-arrow-up me-2"></i>Recycle Bin</h2>
            <p class="text-muted mb-0">Restore customers to your active pipeline.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i>Back to Active List
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-uppercase small fw-bold text-muted">
                    <tr>
                        <th class="ps-4" style="width: 30%;">Company</th>
                        <th style="width: 20%;">Industry</th>
                        <th style="width: 10%;">Status</th>
                        <th style="width: 20%;">Time Archived (IST)</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        // Ensure we don't show hidden items if the service didn't filter them
                        if (!item.IsHiddenFromBin)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@item.CompanyName</div>
                                    <div class="small text-muted">@item.Email</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.Industry</span>
                                </td>
                                <td>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">
                                        Archived
                                    </span>
                                </td>
                                <td class="text-muted small">
                                    @if (item.ArchivedAt.HasValue)
                                    {
                                        /* Robust IST Conversion */
                                        DateTime istDate;
                                        try
                                        {
                                            var istZone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata");
                                            istDate = TimeZoneInfo.ConvertTimeFromUtc(item.ArchivedAt.Value, istZone);
                                        }
                                        catch
                                        {
                                            istDate = item.ArchivedAt.Value.AddHours(5).AddMinutes(30);
                                        }

                                        <div class="fw-bold text-dark">
                                            <i class="fa-regular fa-calendar me-1"></i>
                                            @istDate.ToString("dd-MM-yyyy")
                                        </div>
                                        <div class="text-muted" style="font-size:0.75rem;">
                                            @istDate.ToString("hh:mm tt")
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Unknown</span>
                                    }
                                </td>
                                <td class="text-end pe-4" style="width: 1%; white-space: nowrap;">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <form asp-action="Restore" asp-route-id="@item.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-success fw-bold"
                                                    onclick="return confirm('Restore @item.CompanyName to active list?');">
                                                <i class="fa-solid fa-rotate-left me-1"></i> Restore
                                            </button>
                                        </form>

                                        <form asp-action="Hide" asp-route-id="@item.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary fw-bold"
                                                    title="Dismiss from list (Keep in DB)"
                                                    onclick="return confirm('Dismiss @item.CompanyName from this list? (It will remain in the database)');">
                                                <i class="fa-solid fa-eye-slash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    @if (!Model.Any(m => !m.IsHiddenFromBin))
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <div class="opacity-50 mb-3">
                                    <i class="fa-regular fa-folder-open fa-3x"></i>
                                </div>
                                <h6 class="fw-bold">The bin is empty</h6>
                                <p class="mb-0 small">No archived customers found.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>