@model IEnumerable<CRM.Models.Customer>
@using Microsoft.AspNetCore.Identity

@{
    ViewData["Title"] = "My Customers";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Role Checks
    bool isAdmin = User.IsInRole("Admin");
    bool isManager = User.IsInRole("Sales Manager");
    bool isRep = User.IsInRole("Sales Rep");
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="~/css/Customers/index.css" />

<div class="main-container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Customer Management</h2>
            <p class="text-muted mb-0">
                @if (isRep)
                {
                    <span>Manage your assigned accounts.</span>
                }
                else
                {
                    <span>Overview of all organization accounts.</span>
                }
            </p>
        </div>
        <div class="header-actions">
            @if (isAdmin)
            {
                <a asp-action="Archived" class="btn-action btn-outline">
                    <i class="fa-solid fa-archive"></i> Archived
                </a>
            }

            @if (isAdmin || isManager)
            {
                <a asp-action="Export" class="btn-action btn-outline">
                    <i class="fa-solid fa-download"></i> Export
                </a>
            }

            <a asp-action="Create" class="btn-action btn-primary">
                <i class="fa-solid fa-plus"></i> New Customer
            </a>
        </div>
    </div>

    <div class="stats-bar">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="fa-solid fa-users"></i></div>
            <div class="stat-info">
                <h4 id="totalStatsCount">@Model.Count()</h4>
                <p>Total Customers</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green"><i class="fa-solid fa-user-plus"></i></div>
            <div class="stat-info">
                <h4 id="newStatsCount">@Model.Count(c => c.CreatedAt >= DateTime.Now.AddDays(-30))</h4>
                <p>New This Month</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon orange"><i class="fa-solid fa-briefcase"></i></div>
            <div class="stat-info">
                <h4 id="industryStatsCount">@Model.Select(c => c.Industry).Distinct().Count()</h4>
                <p>Active Industries</p>
            </div>
        </div>
    </div>

    <div class="toolbar">
        <div class="toolbar-row">
            <div class="search-container">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="searchInput" placeholder="Search by name, email, or phone..." />
            </div>

            <select class="form-select" id="industryFilter" style="width: auto;">
                <option value="">All Industries</option>
                @foreach (var industry in Model.Select(c => c.Industry).Distinct().OrderBy(i => i))
                {
                    <option value="@industry">@industry</option>
                }
            </select>

            <select class="form-select" id="statusFilter" style="width: auto;">
                <option value="">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>

            <button class="btn-action btn-outline" id="resetFilters" title="Reset Filters">
                <i class="fa-solid fa-rotate-right"></i>
            </button>
        </div>

        <div id="activeFiltersContainer" class="active-filters" style="display: none;">
            <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); align-self: center;">Active Filters:</span>
            <div id="activeFiltersChips" style="display:contents"></div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-container">
            <div class="table-responsive">
                <table class="table align-middle" id="customersTable">
                    <thead>
                        <tr>
                            <th style="width: 25%;">Company Name</th>
                            <th style="width: 15%;">Industry</th>
                            <th style="width: 20%;">Contact Info</th>
                            <th style="width: 15%;">Location</th>

                            @if (!isRep)
                            {
                                <th style="width: 10%;">Owner</th>
                            }

                            <th style="width: 10%;">Status</th>
                            <th style="width: 10%;">Created</th>
                            <th class="text-end" style="width: 120px; padding-right: 24px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="customersTableBody">
                        @foreach (var item in Model)
                        {
                            <tr class="customer-row"
                                data-company="@item.CompanyName"
                                data-industry="@item.Industry"
                                data-email="@item.Email"
                                data-phone="@item.Phone"
                                data-status="@(item.IsActive ? "active" : "inactive")"
                                data-created="@item.CreatedAt.ToString("yyyy-MM-dd")"
                                data-location="@(item.Address?.Split(',').LastOrDefault()?.Trim() ?? "")">

                                <td>
                                    <div class="company-cell d-flex align-items-center gap-3">
                                        <div class="company-avatar rounded-3 d-flex align-items-center justify-content-center fw-bold text-primary bg-primary-subtle" style="width: 40px; height: 40px;">
                                            @item.CompanyName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div class="company-info">
                                            <div class="fw-bold text-dark">@item.CompanyName</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border fw-normal">
                                        @item.Industry
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1 small">
                                        <div class="text-truncate" style="max-width: 180px;">
                                            <i class="fa-regular fa-envelope text-muted me-1"></i> @(item.Email ?? "-")
                                        </div>
                                        <div>
                                            <i class="fa-solid fa-phone text-muted me-1"></i> @(item.Phone ?? "-")
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Address))
                                    {
                                        <div class="text-truncate" style="max-width: 150px;">
                                            <i class="fa-solid fa-location-dot text-muted me-1"></i>
                                            @(item.Address.Split(',').LastOrDefault()?.Trim())
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>

                                @if (!isRep)
                                {
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-2 border" style="width: 24px; height: 24px;">
                                                <i class="fa-solid fa-user text-muted" style="font-size: 0.7rem;"></i>
                                            </div>
                                            <span class="small text-dark">@(item.SalesRep?.FullName ?? "Unassigned")</span>
                                        </div>
                                    </td>
                                }

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill">Inactive</span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @item.CreatedAt.ToString("MMM dd, yyyy")
                                </td>

                                <td class="text-end" style="padding-right: 24px;">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-primary" title="Edit" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-secondary" title="Details" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>

                                        @if (isAdmin)
                                        {
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                <button type="submit"
                                                        class="btn btn-sm btn-light border text-danger"
                                                        onclick="return confirm('Are you sure you want to delete this customer? This cannot be undone.');"
                                                        title="Delete"
                                                        style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mt-3 text-muted small d-flex justify-content-between">
            <span>Showing <strong id="visibleCount">@Model.Count()</strong> results</span>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <h4>No Customers Found</h4>
            <a asp-action="Create" class="btn-action btn-primary mt-3">Add Customer</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('searchInput');
        const industryFilter = document.getElementById('industryFilter');
        const statusFilter = document.getElementById('statusFilter');
        const resetButton = document.getElementById('resetFilters');

        // Stat Elements
        const totalStatsCount = document.getElementById('totalStatsCount');
        const newStatsCount = document.getElementById('newStatsCount');
        const industryStatsCount = document.getElementById('industryStatsCount');
        const visibleCountElement = document.getElementById('visibleCount');
        const activeFiltersContainer = document.getElementById('activeFiltersContainer');
        const activeFiltersChips = document.getElementById('activeFiltersChips');

        // Initial Logic for "New" (30 days ago)
        const thirtyDaysAgo = new Date();
        thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);

        let searchTimeout;
        searchInput?.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(filterCustomers, 300);
        });

        industryFilter?.addEventListener('change', filterCustomers);
        statusFilter?.addEventListener('change', filterCustomers);

        resetButton?.addEventListener('click', function() {
            searchInput.value = '';
            industryFilter.value = '';
            statusFilter.value = '';
            filterCustomers();
        });

        function filterCustomers() {
            const searchTerm = searchInput.value.toLowerCase().trim();
            const selectedIndustry = industryFilter.value;
            const selectedStatus = statusFilter.value;
            const rows = document.querySelectorAll('.customer-row');

            // Dynamic Counters
            let visibleCount = 0;
            let newCustomersCount = 0;
            let activeIndustriesSet = new Set();

            rows.forEach(row => {
                const company = row.dataset.company.toLowerCase();
                const industry = row.dataset.industry;
                const status = row.dataset.status;
                const email = (row.dataset.email || '').toLowerCase();
                const phone = (row.dataset.phone || '').toLowerCase();
                const createdDateStr = row.dataset.created;

                const matchesSearch = !searchTerm || company.includes(searchTerm) || email.includes(searchTerm) || phone.includes(searchTerm);
                const matchesIndustry = !selectedIndustry || industry === selectedIndustry;
                const matchesStatus = !selectedStatus || status === selectedStatus;

                if (matchesSearch && matchesIndustry && matchesStatus) {
                    row.style.display = '';
                    visibleCount++;
                    const rowDate = new Date(createdDateStr);
                    if (rowDate >= thirtyDaysAgo) {
                        newCustomersCount++;
                    }
                    if (industry) {
                        activeIndustriesSet.add(industry);
                    }
                } else {
                    row.style.display = 'none';
                }
            });

            if (totalStatsCount) totalStatsCount.innerText = visibleCount;
            if (newStatsCount) newStatsCount.innerText = newCustomersCount;
            if (industryStatsCount) industryStatsCount.innerText = activeIndustriesSet.size;
            if (visibleCountElement) visibleCountElement.innerText = visibleCount;

            updateActiveFilters();
        }

        function updateActiveFilters() {
            const activeFilters = [];
            if (searchInput.value) activeFilters.push({ type: 'search', label: `Search: "${searchInput.value}"` });
            if (industryFilter.value) activeFilters.push({ type: 'industry', label: industryFilter.value });
            if (statusFilter.value) activeFilters.push({ type: 'status', label: statusFilter.options[statusFilter.selectedIndex].text });

            if (activeFilters.length > 0) {
                activeFiltersContainer.style.display = 'flex';
                activeFiltersChips.innerHTML = activeFilters.map(filter => `
                    <div class="filter-tag">
                        <span>${filter.label}</span>
                        <i class="fa-solid fa-xmark" onclick="removeFilter('${filter.type}')"></i>
                    </div>
                `).join('');
            } else {
                activeFiltersContainer.style.display = 'none';
            }
        }

        window.removeFilter = function(type) {
            if (type === 'search') searchInput.value = '';
            if (type === 'industry') industryFilter.value = '';
            if (type === 'status') statusFilter.value = '';
            filterCustomers();
        };
    </script>
}