@model IEnumerable<CRM.Models.Customer>

@{
    ViewData["Title"] = "My Customers";
    Layout = "~/Views/Shared/_Layout_App.cshtml";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--mri-blue);">My Customers</h2>
            <p class="text-muted mb-0">Manage your active accounts and leads.</p>
        </div>
        <a asp-action="Create" class="btn text-white" style="background-color: var(--light-green);">
            <i class="fa-solid fa-plus"></i> Add New
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase small text-muted">Company</th>
                        <th class="py-3 text-uppercase small text-muted">Industry</th>
                        <th class="py-3 text-uppercase small text-muted">Contact</th>
                        <th class="py-3 text-uppercase small text-muted text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="fw-bold text-dark">@item.CompanyName</div>
                                <div class="small text-muted"><i class="fa-regular fa-clock me-1"></i> Added: @item.CreatedAt.ToShortDateString()</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.Industry</span>
                            </td>
                            <td>
                                <div class="small"><i class="fa-solid fa-envelope text-muted me-2"></i> @(item.Email ?? "N/A")</div>
                                <div class="small"><i class="fa-solid fa-phone text-muted me-2"></i> @(item.Phone ?? "N/A")</div>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                    Workspace
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('Are you sure you want to remove this customer?');">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="fa-regular fa-folder-open fa-2x mb-3"></i>
                                <p>No customers found. Click "Add New" to get started.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>