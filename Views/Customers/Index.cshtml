@model CRM.DTOS.PagedCustomerDto<CRM.Models.Customer>
@using Microsoft.AspNetCore.Identity

@{
    ViewData["Title"] = "My Customers";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool isAdmin = User.IsInRole("Admin");
    bool isManager = User.IsInRole("Sales Manager");
    bool isRep = User.IsInRole("Sales Rep");
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="~/css/Customers/index.css" />

<div class="main-container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Customer Management</h2>
            <p class="text-muted mb-0">
                @(isRep ? "Manage your assigned accounts." : "Overview of all organization accounts.")
            </p>
        </div>
        <div class="header-actions">
            @if (isAdmin)
            {
                <a asp-action="Archived" class="btn-action btn-outline">
                    <i class="fa-solid fa-archive"></i> Inactive Customers
                </a>
            }

            @if (isAdmin || isManager)
            {
                <a asp-action="Export" class="btn-action btn-outline">
                    <i class="fa-solid fa-download"></i> Export
                </a>
            }

            <a asp-action="Create" class="btn-action btn-primary">
                <i class="fa-solid fa-plus"></i> New Customer
            </a>
        </div>
    </div>

    <div class="stats-bar">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="fa-solid fa-users"></i></div>
            <div class="stat-info">
                <h4 id="totalStatsCount">@Model.TotalCount</h4>
                <p>Total Customers</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green"><i class="fa-solid fa-user-plus"></i></div>
            <div class="stat-info">
                @* Note: For accurate stats in pagination, these should come from the DTO properties *@
                <h4 id="newStatsCount">@Model.Customers.Count(c => c.CreatedAt >= DateTime.Now.AddDays(-30))</h4>
                <p>New on this Page</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon orange"><i class="fa-solid fa-briefcase"></i></div>
            <div class="stat-info">
                <h4 id="industryStatsCount">@Model.Customers.Select(c => c.Industry).Distinct().Count()</h4>
                <p>Industries on Page</p>
            </div>
        </div>
    </div>

    <form asp-action="Index" method="get" class="toolbar">
        <div class="toolbar-row">
            <div class="search-container">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Search all customers..." />
            </div>

            <select class="form-select" name="industry" style="width: auto;" onchange="this.form.submit()">
                <option value="">-- Select Industry --</option>
                <!option value="Technology" @(Model.Industry == "Technology" ? "selected" : "")>Technology</!option>
                <!option value="Finance" @(Model.Industry == "Finance" ? "selected" : "")>Finance</!option>
                <!option value="Manufacturing" @(Model.Industry == "Manufacturing" ? "selected" : "")>Manufacturing</!option>
                <!option value="Healthcare" @(Model.Industry == "Healthcare" ? "selected" : "")>Healthcare</!option>
                <!option value="Retail" @(Model.Industry == "Retail" ? "selected" : "")>Retail</!option>
                <!option value="Other" @(Model.Industry == "" ? "selected" : "")>Other</!option>
                @* Use a separate list of industries if possible, otherwise keep this logic *@
                @foreach (var industry in (ViewBag.Industries as IEnumerable<string> ?? Enumerable.Empty<string>()))
                {
                    <!option value="@industry" @(Model.Industry == industry ? "selected" : "")>@industry</!option>
                }
            </select>

            <select class="form-select" name="status" style="width: auto;" onchange="this.form.submit()">
                <option value="">All Status</option>
                <!option value="active" @(Model.Status == "active" ? "selected" : "")>Active</!option>
                <!option value="inactive" @(Model.Status == "inactive" ? "selected" : "")>Inactive</!option>
            </select>

            <a asp-action="Index" class="btn-action btn-outline" title="Reset Filters">
                <i class="fa-solid fa-rotate-right"></i>
            </a>

            <button type="submit" style="display:none;"></button>
        </div>
    </form>

    @if (Model.Customers.Any())
    {
        <div class="table-container">
            <div class="table-responsive">
                <table class="table align-middle" id="customersTable">
                    <thead>
                        <tr>
                            <th style="width: 25%;">Company Name</th>
                            <th style="width: 15%;">Industry</th>
                            <th style="width: 20%;">Contact Info</th>
                            <th style="width: 15%;">Location</th>

                            @if (!isRep)
                            {
                                <th style="width: 10%;">Owner</th>
                            }

                            <th style="width: 10%;">Status</th>
                            <th style="width: 10%;">Created</th>
                            <th class="text-end" style="width: 120px; padding-right: 24px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="customersTableBody">
                        @foreach (var item in Model.Customers)
                        {
                            <tr class="customer-row"
                                data-industry="@item.Industry"
                                data-status="@(item.IsActive ? "active" : "inactive")">
                                <td>
                                    <div class="company-cell d-flex align-items-center gap-3">
                                        <div class="company-avatar rounded-3 d-flex align-items-center justify-content-center fw-bold text-primary bg-primary-subtle" style="width: 40px; height: 40px;">
                                            @item.CompanyName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div class="company-info">
                                            <div class="fw-bold text-dark">
                                                @(item.CompanyName.Length > 10
                                                  ? item.CompanyName.Substring(0, 10) + "..." 
                                                    : item.CompanyName)
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border fw-normal">@item.Industry</span>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1 small">
                                        <div class="text-truncate" style="max-width: 180px;">
                                            <i class="fa-regular fa-envelope text-muted me-1"></i> @(item.Email ?? "-")
                                        </div>
                                        <div>
                                            <i class="fa-solid fa-phone text-muted me-1"></i> @(item.Phone ?? "-")
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Address))
                                    {
                                        <div class="text-truncate" style="max-width: 150px;">
                                            <i class="fa-solid fa-location-dot text-muted me-1"></i>
                                            @(item.Address.Split(',').LastOrDefault()?.Trim())
                                        </div>
                                    }
                                    else
                                    {

                                        <span class="text-muted small">-</span>
                                    }
                                </td>

                                @if (!isRep)
                                {
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="small text-dark">@(item.SalesRep?.FullName ?? "Unassigned")</span>
                                        </div>
                                    </td>
                                }

                                <td>
                                    <span class="badge @(item.IsActive ? "bg-success-subtle text-success border-success-subtle" : "bg-secondary-subtle text-secondary border-secondary-subtle") border rounded-pill">
                                        @(item.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-muted small">
                                    @item.CreatedAt.ToString("MMM dd, yyyy")
                                </td>

                                <td class="text-end" style="padding-right: 24px;">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-primary" style="width: 32px; height: 32px;"><i class="fa-solid fa-pen"></i></a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-secondary" style="width: 32px; height: 32px;"><i class="fa-solid fa-eye"></i></a>
                                        @* @if (isAdmin)
                                        {
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                <button type="submit" class="btn btn-sm btn-light border text-danger" style="width: 32px; height: 32px;" onclick="return confirm('Delete customer?');">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        } *@
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-muted small">Showing <strong>@Model.StartRecord</strong> to <strong>@Model.EndRecord</strong> of <strong>@Model.TotalCount</strong> entries</span>

            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)">Previous</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@section Scripts {
    <script>
        
    </script>
}