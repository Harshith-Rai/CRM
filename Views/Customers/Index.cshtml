@model IEnumerable<CRM.Models.Customer>

@{
    ViewData["Title"] = "My Customers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="~/css/Customers/index.css" asp-append-version="true" />
<div class="main-container">

    <div class="page-header">
        <div class="header-title">
            <h2>Customer Management</h2>
            <p>View, filter, and manage your organization's accounts.</p>
        </div>
        <div class="header-actions">
            <a asp-action="Archived" class="btn-action btn-outline">
                <i class="fa-solid fa-archive"></i> Archived
            </a>
            <a asp-action="Export" class="btn-action btn-outline">
                <i class="fa-solid fa-download"></i> Export
            </a>
            <a asp-action="Create" class="btn-action btn-primary">
                <i class="fa-solid fa-plus"></i> New Customer
            </a>
        </div>
    </div>

    <div class="stats-bar">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="fa-solid fa-users"></i></div>
            <div class="stat-info">
                <h4>@Model.Count()</h4>
                <p>Total Customers</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green"><i class="fa-solid fa-user-plus"></i></div>
            <div class="stat-info">
                <h4>@Model.Count(c => c.CreatedAt >= DateTime.Now.AddDays(-30))</h4>
                <p>New This Month</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon orange"><i class="fa-solid fa-briefcase"></i></div>
            <div class="stat-info">
                <h4>@Model.Select(c => c.Industry).Distinct().Count()</h4>
                <p>Industries</p>
            </div>
        </div>
    </div>

    <div class="toolbar">
        <div class="toolbar-row">
            <div class="search-container">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="searchInput" class="form-control" placeholder="Search accounts, emails, or IDs..." />
            </div>

            <select class="form-select" id="industryFilter" style="width: auto;">
                <option value="">All Industries</option>
                @foreach (var industry in Model.Select(c => c.Industry).Distinct().OrderBy(i => i))
                {
                    <option value="@industry">@industry</option>
                }
            </select>

            <select class="form-select" id="statusFilter" style="width: auto;">
                <option value="">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>

            <select class="form-select" id="locationFilter" style="width: auto;">
                <option value="">All Locations</option>
                @foreach (var location in Model.Where(c => !string.IsNullOrEmpty(c.Address))
                                .Select(c => c.Address.Split(',').LastOrDefault()?.Trim())
                                .Where(l => !string.IsNullOrEmpty(l)).Distinct().OrderBy(l => l))
                {
                    <option value="@location">@location</option>
                }
            </select>

            <button class="btn-action btn-outline" id="resetFilters" title="Reset">
                <i class="fa-solid fa-rotate-right"></i>
            </button>
        </div>

        <div id="activeFiltersContainer" class="active-filters" style="display: none;">
            <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); align-self: center;">Active Filters:</span>
            <div id="activeFiltersChips" style="display:contents"></div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="customer-grid" id="customersGrid">
            @foreach (var item in Model)
            {
                <div class="customer-card-wrapper"
                     data-company="@item.CompanyName"
                     data-industry="@item.Industry"
                     data-date="@item.CreatedAt.Ticks"
                     data-email="@item.Email"
                     data-phone="@item.Phone"
                     data-status="@(item.IsActive ? "active" : "inactive")"
                     data-location="@(item.Address?.Split(',').LastOrDefault()?.Trim() ?? "")">

                    <div class="customer-card">
                        <div class="card-top">
                            <div class="company-logo">
                                @item.CompanyName.Substring(0, 1).ToUpper()
                            </div>
                            <span class="status-badge @(item.IsActive ? "active" : "inactive")">
                                @(item.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>

                        <div class="company-name">@item.CompanyName</div>
                        <div class="industry-text">
                            <i class="fa-solid fa-building"></i> @item.Industry
                        </div>

                        <div class="card-details">
                            <div class="detail-row">
                                <i class="fa-regular fa-envelope"></i>
                                <span title="@item.Email">@(item.Email ?? "N/A")</span>
                            </div>
                            <div class="detail-row">
                                <i class="fa-solid fa-phone"></i>
                                <span>@(item.Phone ?? "N/A")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(item.Address))
                            {
                                <div class="detail-row">
                                    <i class="fa-solid fa-location-dot"></i>
                                    <span class="text-truncate">@item.Address</span>
                                </div>
                            }
                        </div>

                        <div class="card-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-sm-action primary">
                                <i class="fa-solid fa-arrow-right-to-bracket"></i> Open
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn-sm-action danger" onclick="return confirm('Remove this customer?');">
                                <i class="fa-regular fa-trash-can"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-4 text-center">
            <small class="text-muted" id="resultsCounter">
                Showing <strong id="visibleCount">@Model.Count()</strong> results
            </small>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div style="color: var(--text-muted); font-size: 2rem; margin-bottom: 16px;">
                <i class="fa-regular fa-folder-open"></i>
            </div>
            <h4 style="margin:0 0 8px 0; color: var(--text-main);">No Customers Found</h4>
            <p style="color: var(--text-muted); margin-bottom: 24px;">Get started by adding your first account to the CRM.</p>
            <a asp-action="Create" class="btn-action btn-primary">
                <i class="fa-solid fa-plus"></i> Add Customer
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        // DOM Elements
        const searchInput = document.getElementById('searchInput');
        const industryFilter = document.getElementById('industryFilter');
        const statusFilter = document.getElementById('statusFilter');
        const locationFilter = document.getElementById('locationFilter');
        const resetButton = document.getElementById('resetFilters');
        const customersGrid = document.getElementById('customersGrid');
        const visibleCountElement = document.getElementById('visibleCount');
        const activeFiltersContainer = document.getElementById('activeFiltersContainer');
        const activeFiltersChips = document.getElementById('activeFiltersChips');

        // Search functionality with debounce
        let searchTimeout;
        searchInput?.addEventListener('input', function(e) {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                filterCustomers();
            }, 300);
        });

        // Filters
        industryFilter?.addEventListener('change', filterCustomers);
        statusFilter?.addEventListener('change', filterCustomers);
        locationFilter?.addEventListener('change', filterCustomers);

        // Reset
        resetButton?.addEventListener('click', function() {
            searchInput.value = '';
            industryFilter.value = '';
            statusFilter.value = '';
            locationFilter.value = '';
            filterCustomers();
        });

        // Filter Function
        function filterCustomers() {
            const searchTerm = searchInput.value.toLowerCase().trim();
            const selectedIndustry = industryFilter.value;
            const selectedStatus = statusFilter.value;
            const selectedLocation = locationFilter.value;

            // Note: Updated selector class to match new HTML structure
            const cards = document.querySelectorAll('.customer-card-wrapper');
            let visibleCount = 0;

            cards.forEach(cardWrapper => {
                const company = cardWrapper.dataset.company.toLowerCase();
                const industry = cardWrapper.dataset.industry;
                const status = cardWrapper.dataset.status;
                const location = cardWrapper.dataset.location;
                const email = (cardWrapper.dataset.email || '').toLowerCase();
                const phone = (cardWrapper.dataset.phone || '').toLowerCase();

                const matchesSearch = !searchTerm ||
                                    company.includes(searchTerm) ||
                                    email.includes(searchTerm) ||
                                    phone.includes(searchTerm);

                const matchesIndustry = !selectedIndustry || industry === selectedIndustry;
                const matchesStatus = !selectedStatus || status === selectedStatus;
                const matchesLocation = !selectedLocation || location.toLowerCase().includes(selectedLocation.toLowerCase());

                if (matchesSearch && matchesIndustry && matchesStatus && matchesLocation) {
                    cardWrapper.style.display = 'block';
                    visibleCount++;
                } else {
                    cardWrapper.style.display = 'none';
                }
            });

            if (visibleCountElement) {
                visibleCountElement.textContent = visibleCount;
            }

            updateActiveFilters();
        }

        // Update Chips
        function updateActiveFilters() {
            const activeFilters = [];

            if (searchInput.value) activeFilters.push({ type: 'search', label: `Search: "${searchInput.value}"` });
            if (industryFilter.value) activeFilters.push({ type: 'industry', label: industryFilter.value });
            if (statusFilter.value) activeFilters.push({ type: 'status', label: statusFilter.options[statusFilter.selectedIndex].text });
            if (locationFilter.value) activeFilters.push({ type: 'location', label: locationFilter.value });

            if (activeFilters.length > 0) {
                activeFiltersContainer.style.display = 'flex';
                activeFiltersChips.innerHTML = activeFilters.map(filter => `
                    <div class="filter-tag">
                        <span>${filter.label}</span>
                        <i class="fa-solid fa-xmark" onclick="removeFilter('${filter.type}')"></i>
                    </div>
                `).join('');
            } else {
                activeFiltersContainer.style.display = 'none';
            }
        }

        window.removeFilter = function(type) {
            if (type === 'search') searchInput.value = '';
            if (type === 'industry') industryFilter.value = '';
            if (type === 'status') statusFilter.value = '';
            if (type === 'location') locationFilter.value = '';
            filterCustomers();
        };
    </script>
}