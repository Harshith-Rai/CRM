@model CRM.Models.Lead

@{
    ViewData["Title"] = "New Deal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fa-solid fa-money-bill-wave me-2"></i>New Opportunity</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold">Deal Name</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. 500 License Upgrade" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Customer</label>
                    <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomerId">
                        <option value="">-- Select Company --</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Value" class="form-label fw-bold">Estimated Value ($)</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Value" class="form-control" type="number" step="0.01" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Source" class="form-label fw-bold">Source</label>
                    <select asp-for="Source" class="form-select">
                        <option value="Cold Call">Cold Call</option>
                        <option value="Website">Website</option>
                        <option value="Referral">Referral</option>
                        <option value="Email Campaign">Email Campaign</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-light">Cancel</a>
                    <button type="submit" class="btn btn-primary">Create Deal</button>
                </div>
            </form>
        </div>
    </div>
</div>