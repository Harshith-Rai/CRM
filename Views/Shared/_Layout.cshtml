<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" />

    <style>
        :root {
            --light-blue: #C2E6F2;
            --mri-blue: #044D66;
            --medium-blue: #187ABF;
            --white: #ffffff;
            --bg-gray: #F1F5F9;
        }

        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-gray);
            display: flex; /* Critical: Creates the side-by-side layout */
            height: 100vh;
            overflow: hidden;
        }

        /* --- Sidebar --- */
        .sidebar {
            width: 250px;
            background-color: var(--mri-blue);
            color: var(--white);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
        }

        .brand {
            padding: 20px;
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--light-blue);
            border-bottom: 1px solid rgba(255,255,255,0.1);
            text-decoration: none;
        }

        .menu {
            flex: 1;
            padding-top: 20px;
            overflow-y: auto;
        }

        .menu-item {
            display: flex;
            align-items: center;
            padding: 15px 25px;
            color: rgba(255,255,255,0.8);
            text-decoration: none;
            transition: 0.2s;
        }

            .menu-item:hover, .menu-item.active {
                background: rgba(255,255,255,0.1);
                color: var(--white);
                border-left: 4px solid var(--light-blue);
            }

            .menu-item i {
                width: 25px;
                margin-right: 10px;
            }

        /* --- Content Area --- */
        .main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            position: relative;
        }

        .app-navbar {
            background: var(--white);
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            z-index: 1000;
        }
    </style>
</head>
<body>

    @* --- Sidebar Section --- *@
    @{
        var routeValues = ViewContext.RouteData.Values;
        var currentController = routeValues["controller"]?.ToString();
        var currentAction = routeValues["action"]?.ToString();
        var isAuthPage = currentController?.ToLowerInvariant() == "account" &&
        (currentAction?.ToLowerInvariant() == "login" || currentAction?.ToLowerInvariant() == "register");
    }

    @if (!isAuthPage)
    {
        <div class="sidebar">
            <a href="/" class="brand">CRM Portal</a>
            <div class="menu">
                <a href="@Url.Action("Index", "SalesRep")" class="menu-item @(currentController == "SalesRep" ? "active" : "")">
                    <i class="fa-solid fa-gauge-high"></i> Dashboard
                </a>
                <a href="#" class="menu-item"><i class="fa-solid fa-address-book"></i> My Leads</a>
                <a href="#" class="menu-item"><i class="fa-solid fa-money-bill-trend-up"></i> Pipeline</a>
                <a href="#" class="menu-item"><i class="fa-solid fa-calendar-check"></i> Tasks</a>
            </div>
        </div>
    }

    <div class="main-wrapper">
        @if (!isAuthPage)
        {
            <nav class="navbar navbar-expand-lg app-navbar sticky-top">
                <div class="container-fluid px-4">
                    <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index", "Home")" style="color: var(--mri-blue); font-weight: 700;">
                        Hello User
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNavbar">
                        <form class="d-flex mx-auto navbar-search" role="search" style="max-width: 400px; width: 100%;">
                            <div class="input-group">
                                <input class="form-control" type="search" placeholder="Search leads...">
                                <button class="btn btn-outline-secondary" type="submit"><i class="fas fa-search"></i></button>
                            </div>
                        </form>

                        <ul class="navbar-nav ms-auto align-items-center">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle fa-2x" style="color: var(--mri-blue);"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account")"><i class="fa-solid fa-right-from-bracket me-2"></i>Sign out</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        }

        <main role="main" class="p-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>