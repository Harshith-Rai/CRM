@using Microsoft.AspNetCore.Identity
@using CRM.Models
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/_layout.css" asp-append-version="true" />
</head>
<body>

    @{
        var routeValues = ViewContext.RouteData.Values;
        var currentController = routeValues["controller"]?.ToString();
        var currentAction = routeValues["action"]?.ToString();
        var isAuthPage = currentController?.ToLowerInvariant() == "account" &&
        (currentAction?.ToLowerInvariant() == "login" || currentAction?.ToLowerInvariant() == "register");

        ApplicationUser currentUser = null;
        if (User.Identity.IsAuthenticated)
        {
            currentUser = await UserManager.GetUserAsync(User);
        }
    }

    @if (!isAuthPage)
    {
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <div class="sidebar" id="sidebar">
            <a href="/" class="brand">
                <span>CRM Portal</span>
            </a>

            <div class="menu">
                <a href="@Url.Action("Index", "Home")" class="menu-item @(currentController == "Home" ? "active" : "")">
                    <i class="fa-solid fa-gauge-high"></i> Dashboard
                </a>
                <a href="@Url.Action("Index", "Customers")" class="menu-item @(currentController == "Customers" ? "active" : "")">
                    <i class="fa-solid fa-address-book"></i> My Customers
                </a>
                <a href="@Url.Action("Index", "Tasks")" class="menu-item @(currentController == "Tasks" ? "active" : "")">
                    <i class="fa-solid fa-calendar-check"></i> My Tasks
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <hr style="border-color: rgba(255,255,255,0.2); margin: 15px 0;" />
                    <a asp-controller="AdminUser" asp-action="index" class="menu-item @(currentController == "AdminUser" ? "active" : "")">
                        <i class="fa-solid fa-shield-halved"></i> Admin Panel
                    </a>
                }
            </div>

            <div class="sidebar-footer">
                <div class="sidebar-profile-box">
                    <i class="fas fa-user-circle"></i>
                    <div class="sidebar-profile-info">
                        <div class="sidebar-profile-name">
                            @(currentUser?.FullName ?? User.Identity?.Name)
                        </div>
                        <div class="sidebar-profile-email" title="@(currentUser?.Email ?? "user@example.com")">
                            @(currentUser?.Email ?? "user@example.com")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="main-wrapper">
        @if (!isAuthPage)
        {
            <nav class="navbar app-navbar sticky-top">
                <div class="container-fluid px-2 px-md-4 flex-nowrap gap-2">

                    <div class="d-flex align-items-center flex-shrink-0">
                        <button class="btn p-0 me-2 d-lg-none" id="mobileMenuToggle" style="color: var(--mri-blue); font-size: 1.4rem; border:none; background:transparent;">
                            <i class="fas fa-bars"></i>
                        </button>

                        <a class="navbar-brand d-flex align-items-center me-0 text-truncate" href="@Url.Action("Index", "Home")" style="max-width: 120px;">
                            Hello, @(currentUser?.FullName?.Split(' ')[0] ?? User.Identity?.Name ?? "Guest")
                        </a>
                    </div>

                    <form class="navbar-search flex-grow-1" role="search">
                        <div class="input-group">
                            <input class="form-control" type="search" placeholder="Search...">
                            <button class="btn btn-outline-secondary" type="submit" style="padding: 0 10px;"><i class="fas fa-search"></i></button>
                        </div>
                    </form>

                    <div class="dropdown flex-shrink-0">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="text-end d-none d-lg-block" style="font-size: 0.85rem; line-height: 1.3;">
                                <div style="font-weight: 600; color: var(--mri-blue);">@(currentUser?.FullName ?? User.Identity?.Name)</div>
                                <div style="color: #64748b; font-size: 0.8rem;">@(currentUser?.Email ?? "user@example.com")</div>
                            </div>
                            <i class="fas fa-user-circle fa-2x" style="color: var(--mri-blue);"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                            <li>
                                <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger" style="cursor: pointer;">
                                        <i class="fa-solid fa-right-from-bracket me-2"></i>Sign out
                                    </button>
                                </form>
                            </li>
                        </ul>

                    </div>

                </div>
            </nav>
        }

        <main role="main" class="p-3 p-lg-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.getElementById('sidebar');
            const mobileToggle = document.getElementById('mobileMenuToggle');
            const overlay = document.getElementById('sidebarOverlay');

            // Sidebar Toggle Logic
            if (mobileToggle) {
                mobileToggle.addEventListener('click', function(e) {
                    e.stopPropagation();
                    sidebar.classList.toggle('mobile-active');
                    if (overlay) overlay.classList.toggle('active');
                });
            }

            function closeSidebar() {
                sidebar.classList.remove('mobile-active');
                if (overlay) overlay.classList.remove('active');
            }

            if (overlay) overlay.addEventListener('click', closeSidebar);


            document.querySelectorAll('.menu-item').forEach(item => {
                item.addEventListener('click', function() {
                    if (window.innerWidth <= 991) closeSidebar();
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>